# ==========================================
# ParivarSetu .gitignore
# ==========================================

# --- Environment & Secret Files (Global) ---
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Preserve example templates
!.env.example
!**/.env.example

# --- Python / Backend ---
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.pyc
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/
backend/env/

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Operating System & IDE ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*~
